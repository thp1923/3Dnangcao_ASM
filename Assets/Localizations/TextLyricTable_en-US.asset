  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TextLyricTable_en-US
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en-US
  m_SharedData: {fileID: 11400000, guid: d11ef30f44e153746a20384cebde6558, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 8118292480
    m_Localized: I walk this path alone
    m_Metadata:
      m_Items: []
  - m_Id: 668800864256
    m_Localized: No crest upon my shield
    m_Metadata:
      m_Items: []
  - m_Id: 13529698750464
    m_Localized: Just steel and stone
    m_Metadata:
      m_Items: []
  - m_Id: 23486997417984
    m_Localized: But faith that will not yield
    m_Metadata:
      m_Items: []
  - m_Id: 87126399827968
    m_Localized: They ask my name before the fight
    m_Metadata:
      m_Items: []
  - m_Id: 87548757852160
    m_Localized: I simply shake my head
    m_Metadata:
      m_Items: []
  - m_Id: 87973510823936
    m_Localized: It's not my title that brings light
    m_Metadata:
      m_Items: []
  - m_Id: 88260392828928
    m_Localized: But evil's coming death
    m_Metadata:
      m_Items: []
  - m_Id: 89214433411072
    m_Localized: No name to fear
    m_Metadata:
      m_Items: []
  - m_Id: 89518268792832
    m_Localized: no name to fall
    m_Metadata:
      m_Items: []
  - m_Id: 91115325538304
    m_Localized: Oh-oh-oh-oh-oh-oh
    m_Metadata:
      m_Items: []
  - m_Id: 91848326299648
    m_Localized: I stand between the dark and all
    m_Metadata:
      m_Items: []
  - m_Id: 94095470804992
    m_Localized: Tonight the devil's reign will fall
    m_Metadata:
      m_Items: []
  - m_Id: 95339132272640
    m_Localized: Your chains won't bind my soul
    m_Metadata:
      m_Items: []
  - m_Id: 95964540747776
    m_Localized: Your tricks won't cloud my mind
    m_Metadata:
      m_Items: []
  - m_Id: 96468037582848
    m_Localized: I've come to end your hold
    m_Metadata:
      m_Items: []
  - m_Id: 97033048080384
    m_Localized: Your time is left behind
    m_Metadata:
      m_Items: []
  - m_Id: 97455355772928
    m_Localized: They'll write no stories of my face
    m_Metadata:
      m_Items: []
  - m_Id: 97754321567744
    m_Localized: No songs about my past
    m_Metadata:
      m_Items: []
  - m_Id: 98209764261888
    m_Localized: But when I leave this cursed place
    m_Metadata:
      m_Items: []
  - m_Id: 98647179837440
    m_Localized: Your power won't last!
    m_Metadata:
      m_Items: []
  - m_Id: 102158764392448
    m_Localized: Rise up
    m_Metadata:
      m_Items: []
  - m_Id: 103458721808384
    m_Localized: Fight on
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
