  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TextLyricTable_vi-VN
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: vi-VN
  m_SharedData: {fileID: 11400000, guid: d11ef30f44e153746a20384cebde6558, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 8118292480
    m_Localized: "T\xF4i b\u01B0\u1EDBc \u0111\u01A1n \u0111\u1ED9c tr\xEAn con \u0111\u01B0\u1EDDng
      \u0111\u1ECBnh m\u1EC7nh"
    m_Metadata:
      m_Items: []
  - m_Id: 668800864256
    m_Localized: "Kh\xF4ng huy hi\u1EC7u kh\u1EAFc tr\xEAn t\u1EA5m khi\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 13529698750464
    m_Localized: "Ch\u1EC9 c\xF3 th\xE9p v\xE0 \u0111\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 23486997417984
    m_Localized: "Nh\u01B0ng ni\u1EC1m tin kh\xF4ng bao gi\u1EDD g\u1EE5c ng\xE3"
    m_Metadata:
      m_Items: []
  - m_Id: 87126399827968
    m_Localized: "H\u1ECD h\u1ECFi t\xEAn t\xF4i tr\u01B0\u1EDBc cu\u1ED9c chi\u1EBFn"
    m_Metadata:
      m_Items: []
  - m_Id: 87548757852160
    m_Localized: "T\xF4i ch\u1EC9 m\u1EC9m c\u01B0\u1EDDi, l\u1EAFc \u0111\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 87973510823936
    m_Localized: "Kh\xF4ng ph\u1EA3i danh x\u01B0ng \u0111em l\u1EA1i \xE1nh b\xECnh
      minh"
    m_Metadata:
      m_Items: []
  - m_Id: 88260392828928
    m_Localized: "M\xE0 l\xE0 c\xE1i ch\u1EBFt c\u1EE7a qu\u1EF7 \u0111ang c\u1EADn
      k\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 89214433411072
    m_Localized: "Kh\xF4ng t\xEAn \u0111\u1EC3 s\u1EE3"
    m_Metadata:
      m_Items: []
  - m_Id: 89518268792832
    m_Localized: "ch\u1EB3ng t\xEAn \u0111\u1EC3 khu\u1EA5t ph\u1EE5c"
    m_Metadata:
      m_Items: []
  - m_Id: 91115325538304
    m_Localized: Oh-oh-oh-oh-oh-oh
    m_Metadata:
      m_Items: []
  - m_Id: 91848326299648
    m_Localized: "T\xF4i \u0111\u1EE9ng ch\u1EAFn gi\u1EEFa m\xE0n \u0111\xEAm v\xE0
      th\u1EBF gian n\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 94095470804992
    m_Localized: "\u0110\xEAm nay, ngai v\xE0ng c\u1EE7a qu\u1EF7 d\u1EEF s\u1EBD
      s\u1EE5p \u0111\u1ED5"
    m_Metadata:
      m_Items: []
  - m_Id: 95339132272640
    m_Localized: "Xi\u1EC1ng x\xEDch c\u1EE7a ng\u01B0\u01A1i s\u1EBD kh\xF4ng th\u1EC3
      tr\xF3i linh h\u1ED3n ta"
    m_Metadata:
      m_Items: []
  - m_Id: 95964540747776
    m_Localized: "M\u01B0u m\u1EB9o c\u1EE7a ng\u01B0\u01A1i s\u1EBD kh\xF4ng l\xE0m
      m\u1EDD tr\xED ta"
    m_Metadata:
      m_Items: []
  - m_Id: 96468037582848
    m_Localized: "Ta \u0111\u1EBFn \u0111\u1EC3 ch\u1EA5m d\u1EE9t quy\u1EC1n l\u1EF1c
      c\u1EE7a ng\u01B0\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 97033048080384
    m_Localized: "Th\u1EDDi kh\u1EAFc c\u1EE7a ng\u01B0\u01A1i \u0111\xE3 l\xF9i
      v\xE0o d\u0129 v\xE3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 97455355772928
    m_Localized: "S\u1EBD ch\u1EB3ng ai kh\u1EAFc h\u1ECDa g\u01B0\u01A1ng m\u1EB7t
      ta trong huy\u1EC1n s\u1EED"
    m_Metadata:
      m_Items: []
  - m_Id: 97754321567744
    m_Localized: "Kh\xF4ng b\xE0i ca n\xE0o k\u1EC3 v\u1EC1 h\xE0nh tr\xECnh c\u1EE7a
      t\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 98209764261888
    m_Localized: "Nh\u01B0ng khi ta r\u1EDDi kh\u1ECFi mi\u1EC1n \u0111\u1EA5t b\u1ECB
      nguy\u1EC1n r\u1EE7a n\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 98647179837440
    m_Localized: "Ngai quy\u1EC1n l\u1EF1c c\u1EE7a ng\u01B0\u01A1i s\u1EBD tan th\xE0nh
      tro b\u1EE5i!"
    m_Metadata:
      m_Items: []
  - m_Id: 102158764392448
    m_Localized: "H\xE3y \u0111\u1EE9ng l\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 103458721808384
    m_Localized: "H\xE3y chi\u1EBFn \u0111\u1EA5u"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
